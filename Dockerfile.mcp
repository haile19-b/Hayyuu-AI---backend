# Standalone Production Model Context Protocol (MCP) Server Container
# Official lightweight Python base with uv
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

# Set Python and uv runtime behaviors
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_SYNC=1 \
    UV_NO_DEV=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/.venv/Lib/site-packages:/app"

# Install minimal OS libraries: Prisma binaries, OpenSSL 3, libatomic1 for Node, curl for healthchecks
# Excludes heavy graphic/ML packages (libgl1, libgomp1) for lean footprint
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libssl3 \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency specifications first to maximize Docker layer caching
COPY pyproject.toml uv.lock .python-version README.md ./

# Install core project dependencies without heavy ML extras (PyTorch / Docling)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# Ensure Linux Python compatibility for Prisma schema output path (../.venv/Lib -> .venv/lib/python3.11)
RUN mkdir -p /app/.venv/lib/python3.11/site-packages && \
    ln -sfn /app/.venv/lib/python3.11 /app/.venv/Lib

# Copy Prisma schema and generate typed Prisma Client Python
COPY prisma/ ./prisma/
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"
RUN uv run --no-dev prisma generate --schema=prisma/schema.prisma

# Copy application source code
COPY . .

# Finalize core project installation
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Expose MCP Server HTTP/SSE port
EXPOSE 8001

# Healthcheck configuration against the /health endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
    CMD curl -f http://localhost:8001/health || exit 1

# Default entrypoint: boots the MCP server in SSE mode on port 8001
CMD ["uv", "run", "python", "-m", "app.infrastructure.mcp.server", "--transport", "sse", "--host", "0.0.0.0", "--port", "8001"]
