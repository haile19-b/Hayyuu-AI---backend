datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  output               = "../.venv/Lib/site-packages/prisma"
  recursive_type_depth = 5
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  PENDING
  INDEXED
  FAILED
}

enum RequirementStatus {
  DRAFT
  SUGGESTION
  APPROVED
  REJECTED
}

enum RequirementPriority {
  P0
  P1
  P2
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  P0
  P1
  P2
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TaskSource {
  USER
  SYSTEM
}

enum TaskApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum ConflictSeverity {
  HIGH
  MEDIUM
  LOW
}

enum ConflictStatus {
  ACTIVE
  RESOLVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MemoryType {
  SEMANTIC
  EPISODIC
  PROCEDURAL
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id             String               @id @default(uuid())
  email          String               @unique
  hashedPassword String
  fullName       String
  userName       String
  githubToken    String?              // Stores encrypted GitHub access token
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  projects       Project[]
  sessions       Session[]
  threads        ConversationThread[]
  memories       MemoryRecord[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Project {
  id                   String                @id @default(uuid())
  userId               String
  name                 String
  description          String?
  status               ProjectStatus         @default(ACTIVE)
  githubInstallationId String?
  githubRepoOwner      String?
  githubRepoName       String?
  githubRepoUrl        String?
  githubConnectedAt    DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  owner                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            Document[]
  requirements         Requirement[]
  tasks                Task[]
  suggestions          AISuggestion[]
  conflicts            RequirementConflict[]
  repositories         ProjectRepository[]
  threads              ConversationThread[]
  workflowRuns         AgentWorkflowRun[]
  memories             MemoryRecord[]

  @@map("projects")
}

model ProjectRepository {
  id            String   @id @default(uuid())
  projectId     String
  owner         String
  name          String
  fullName      String   @unique
  htmlUrl       String
  defaultBranch String   @default("main")
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_repositories")
}

model Document {
  id         String         @id @default(uuid())
  projectId  String
  name       String
  filePath   String
  fileType   String
  sizeBytes  Int
  status     DocumentStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Requirement {
  id           String              @id @default(uuid())
  projectId    String
  title        String
  description  String
  type         RequirementType     @default(FUNCTIONAL)
  priority     RequirementPriority @default(P2)
  status       RequirementStatus   @default(DRAFT)
  isConflicted Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  conflicts    RequirementConflict[] @relation("RequirementConflicts")
  conflictedBy RequirementConflict[] @relation("ConflictingRequirements")

  @@map("requirements")
}

model Task {
  id             String             @id @default(uuid())
  projectId      String
  requirementId  String?
  title          String
  description    String
  priority       TaskPriority       @default(P2)
  status         TaskStatus         @default(TODO)
  source         TaskSource         @default(USER)
  approvalStatus TaskApprovalStatus @default(APPROVED)
  githubIssueUrl String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement?       @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model AISuggestion {
  id        String           @id @default(uuid())
  projectId String
  type      String           // "requirement", "task", "conflict_resolution"
  content   Json             // Dynamic JSON payload for the suggestion details
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_suggestions")
}

model RequirementConflict {
  id                       String           @id @default(uuid())
  projectId                String
  requirementId            String
  conflictingRequirementId String
  severity                 ConflictSeverity @default(MEDIUM)
  description              String
  aiRecommendation         String?
  status                   ConflictStatus   @default(ACTIVE)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  project                  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement              Requirement      @relation("RequirementConflicts", fields: [requirementId], references: [id], onDelete: Cascade)
  conflictingRequirement   Requirement      @relation("ConflictingRequirements", fields: [conflictingRequirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, conflictingRequirementId])
  @@map("requirement_conflicts")
}

// ---------------------------------------------------------------------------
// Multi-Agent Chat Threads, Memory & Durable Workflow Run Extensions
// ---------------------------------------------------------------------------

model ConversationThread {
  id             String             @id @default(uuid())
  projectId      String
  userId         String
  title          String?            @default("New Conversation")
  cognitiveState Json?              // MetaMo state: goals, anti-goals, modulators, turn_count, context_history
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  workflowRuns   AgentWorkflowRun[]

  @@index([projectId, userId])
  @@map("conversation_threads")
}

model ChatMessage {
  id              String             @id @default(uuid())
  threadId        String
  role            MessageRole
  content         String             @db.Text
  cognitiveAction String?            // MetaMo action: act_clarify, act_search, act_verify, etc.
  styleModifier   String?            // style_concise, style_thorough, style_cautious, style_tutorial, style_exploratory
  reasoning       String?            @db.Text
  toolCalls       Json?              // Executed MCP tool calls and arguments
  metadata        Json?
  createdAt       DateTime           @default(now())
  thread          ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // Note: Deliberation telemetry (score_top3, reason, homeostatic states) is strictly NOT stored in PostgreSQL 
  // to avoid database bloat. It is written out-of-band to structured CSV files (logs/eval/turns.csv).

  // Compound B-Tree index for sub-2ms chronological window pagination
  @@index([threadId, createdAt(sort: Asc)])
  @@map("chat_messages")
}

model MemoryRecord {
  id           String     @id @default(uuid())
  userId       String
  projectId    String?
  type         MemoryType
  key          String     // Hierarchical key, e.g. "architecture/database"
  content      String     @db.Text
  importance   Float      @default(0.5)
  accessCount  Int        @default(0)
  lastAccessed DateTime   @default(now())
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId, type])
  @@index([key])
  @@map("memory_records")
}

model AgentWorkflowRun {
  id           String              @id @default(uuid())
  projectId    String
  threadId     String?
  workflowType String              // "requirements_extraction", "conflict_resolution", "task_planning"
  status       WorkflowStatus      @default(PENDING)
  inputPayload Json?
  result       Json?
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  thread       ConversationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("agent_workflow_runs")
}
