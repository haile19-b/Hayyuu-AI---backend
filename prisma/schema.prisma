datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-py"
  recursive_type_depth = 5
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  hashedPassword String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[]

  @@map("users") // Maps model name to lowercase table name
}

model Project {
  id           String        @id @default(uuid())
  userId       String
  name         String
  description  String?
  status       String        @default("active") // "active", "archived"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]
  requirements Requirement[]
  tasks        Task[]

  @@map("projects")
}

model Document {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  filePath   String
  fileType   String
  sizeBytes  Int
  status     String   @default("pending") // "pending", "indexed", "failed"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Requirement {
  id           String   @id @default(uuid())
  projectId    String
  title        String
  description  String
  priority     String   @default("P2") // "P0", "P1", "P2"
  status       String   @default("draft") // "draft", "approved"
  isConflicted Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@map("requirements")
}

model Task {
  id             String       @id @default(uuid())
  projectId      String
  requirementId  String?
  title          String
  description    String
  priority       String       @default("P2")
  status         String       @default("todo") // "todo", "in_progress", "done", "blocked"
  githubIssueUrl String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@map("tasks")
}